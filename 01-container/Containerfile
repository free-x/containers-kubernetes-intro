# Stage 1: Build
FROM registry.access.redhat.com/ubi10/openjdk-21:latest AS builder

USER root
WORKDIR /build

COPY demo-app /build/

RUN mvn -q package -DskipTests

# Stage 2: Runtime (minimal)
FROM registry.access.redhat.com/ubi10/openjdk-21-runtime:latest

WORKDIR /app

USER root
RUN mkdir -p /var/demo/html && \
    echo '<html><body><h1>Hallo von Container!</h1></body></html>' > /var/demo/html/index.html && \
    chown -R 1001:0 /var/demo/html && \
    chmod -R g=u /var/demo/html

COPY --from=builder /build/target/*.jar app.jar

# Non-Root User (kompatibel mit restricted-v2 SCC)
USER 1001

EXPOSE 8080

CMD ["java", "-jar", "/app/app.jar"]
